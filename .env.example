# =====================================================================
# CONFIGURACIÓN DE INFRAESTRUCTURA Y SERVICIOS (MLOps Deployment)
# Mantenimiento Predictivo - Área de Helados
# =====================================================================
# NOTA: Este archivo es una plantilla de ejemplo (.env.example).
# Copia este archivo a `.env` y completa con las credenciales deseadas.
# NUNCA agregues contraseñas reales a este archivo versionado en Git.

# ---------------------------------------------------------------------
# 1. Configuración de MinIO (Almacenamiento de Objetos S3 Compatible)
# ---------------------------------------------------------------------
MINIO_ROOT_USER=admin_helados
MINIO_ROOT_PASSWORD=SuperSecretPassword2026!
MINIO_BUCKET=dvc-storage
MINIO_ENDPOINT=http://minio:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------
# 2. Configuración de Credenciales S3 para DVC (Data & Model Versioning)
# ---------------------------------------------------------------------
# Deben coincidir con el usuario y contraseña de MinIO para acceso local/docker
AWS_ACCESS_KEY_ID=admin_helados
AWS_SECRET_ACCESS_KEY=SuperSecretPassword2026!
AWS_DEFAULT_REGION=us-east-1
DVC_S3_ENDPOINT=http://localhost:9000

# ---------------------------------------------------------------------
# 3. Configuración del Servicio Backend (FastAPI Inferencia)
# ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8502
PROJECT_ROOT=.

# ---------------------------------------------------------------------
# 4. Configuración del Servicio Frontend (Dashboard Streamlit)
# ---------------------------------------------------------------------
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501
# URL utilizada por Streamlit para invocar los endpoints de FastAPI
# En Docker Compose usar: http://api:8502
# En entorno local usar: http://127.0.0.1:8502
API_URL=http://api:8502
API_BASE_URL=http://api:8502
